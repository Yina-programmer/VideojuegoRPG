# ============================================================
# Variables de entorno — VideojuegoRPG Backend
# Copia este archivo como .env y completa los valores reales.
# NUNCA subas .env a Git.
# ============================================================

# URL de conexión a PostgreSQL (base de datos de desarrollo)
# Formato: postgresql://usuario:contraseña@host:puerto/nombre_base_de_datos
DATABASE_URL=postgresql://postgres:tu_contraseña@localhost:5433/videojuego_rpg

# Puerto en que escucha la API
PORT=4000

# Entorno de ejecución: development | production | test
NODE_ENV=development
