# ============================================================
# Variables de entorno — Tests (base de datos separada)
# Copia este archivo como .env.test y completa los valores reales.
# NUNCA subas .env.test a Git.
# ============================================================

# URL de la base de datos exclusiva para tests.
# Debe ser una base DIFERENTE a la de desarrollo para no contaminar los datos.
# Ejemplo: videojuego_rpg_test
TEST_DATABASE_URL=postgresql://postgres:tu_contraseña@localhost:5433/videojuego_rpg_test
