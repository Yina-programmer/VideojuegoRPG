[sub_resource type="Shader" id="CompleteAtlasKeyShader"]
code = "shader_type canvas_item;

void fragment() {
	vec4 pixel = texture(TEXTURE, UV);
	float peak = max(pixel.r, max(pixel.g, pixel.b));
	if (peak < 0.035) {
		discard;
	}
	COLOR = pixel * COLOR;
}
"

