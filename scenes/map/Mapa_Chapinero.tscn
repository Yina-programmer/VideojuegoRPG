[node name="PointOfInteres" parent="." unique_id=775087451 instance=ExtResource("3_nbb1n")]
position = Vector2(-633.00006, -1480.0001)
scale = Vector2(37, 28)
place_id = "hippies"
place_name = "Parque de los Hippies"
category = "Cultura urbana"
description = "El Parque de los Hippies es uno de los lugares representativos de Chapinero y constituye un punto de encuentro cultural, artístico y social de la localidad. Su plazoleta reúne expresiones urbanas, música, conversación y distintas formas de habitar colectivamente la ciudad."
discovery_hint = "Un espacio donde el arte y las historias se encuentran."
related_npc_name = "Nico"
category_color = Color(0.93, 0.48, 0.25, 1)

[node name="PolitecnicoPOI" parent="." unique_id=2128788537 instance=ExtResource("3_nbb1n")]
position = Vector2(-631.00006, -2792)
scale = Vector2(36, 32)
place_id = "politecnico"
place_name = "Politécnico Grancolombiano"
category = "Educación, tecnología e innovación"
description = "¿Sabías que el Politécnico Grancolombiano comenzó su historia hace más de cuatro décadas?

La institución fue fundada en 1980 y comenzó sus actividades académicas en marzo de 1981. Desde sus primeros años ofreció formación tecnológica, incluyendo estudios relacionados con la administración de sistemas.

En 1991 adquirió el carácter de institución universitaria y con el paso del tiempo amplió su oferta académica, incorporando nuevas modalidades de formación.

Su campus en Chapinero reúne espacios de aprendizaje, una biblioteca y recursos audiovisuales dedicados a la fotografía, el sonido y la producción de contenidos.

Hoy, el Poli representa un punto de encuentro entre estudiantes, tecnología y creatividad. Aquí las ideas pueden convertirse en investigaciones, proyectos y soluciones para la sociedad.

Dato interesante: la formación relacionada con los sistemas y la tecnología formó parte de sus primeros años de enseñanza.

Fuentes de referencia:
https://www.poli.edu.co/fundadores
https://www.poli.edu.co/crea/areas-que-componen-el-crea"
discovery_hint = "Un lugar donde las ideas se transforman en conocimiento."
related_npc_name = "Polito"
category_color = Color(0.2, 0.67, 0.87, 1)

[node name="TheatronPOI" parent="." unique_id=66344684 instance=ExtResource("3_nbb1n")]
position = Vector2(-4296, 468)
scale = Vector2(18, 16)
place_id = "theatron"
place_name = "Theatron: historia, música y diversidad"
category = "Vida nocturna, cultura y diversidad"
description = "¿Sabías que antes de convertirse en uno de los lugares más representativos de la vida nocturna de Bogotá, Theatron fue un cine?

En este edificio funcionó el antiguo cine Metro Riviera. Con el paso de los años, el espacio tuvo diferentes usos, incluyendo una etapa como iglesia.

En 2002 comenzó una nueva historia: el lugar se transformó en un espacio de entretenimiento, música y encuentro.

Con el tiempo, Theatron creció y reunió diferentes ambientes musicales, convirtiéndose en uno de los referentes de la vida nocturna de Chapinero.

Pero su importancia no está solamente en las fiestas. También se ha convertido en un espacio simbólico de visibilidad, encuentro y expresión para la comunidad LGBTIQ+.

Dato interesante: el edificio ha pasado de proyectar películas a reunir personas de diferentes culturas e identidades alrededor de la música.

Su historia demuestra cómo un mismo lugar puede transformarse y adquirir nuevos significados para una ciudad.

Fuentes de referencia:
https://bogota.gov.co/mi-ciudad/desarrollo-economico/orgullo-lgbti-en-bogota-empresas-y-organizaciones-con-diversidad
https://www.archdaily.cl/cl/941293/theatron-espacios-que-aprenden-en-colombia"
discovery_hint = "Un antiguo escenario que encontró una nueva forma de brillar."
related_npc_name = "Dante"
category_color = Color(0.73, 0.43, 0.92, 1)

